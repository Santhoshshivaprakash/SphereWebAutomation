{
  "name": "spherewebautomation",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "//interactive": "── Interactive runner: pick environment/URL + spec ──",
    "go": "node scripts/run.mjs",
    "go:both": "cross-env BASE_URL=both node scripts/run.mjs",
    "login:check": "node scripts/login-check.mjs",
    "check:login": "node scripts/check-login.mjs",
    "//compare": "── Environment comparison (prod vs staging, side by side) ──",
    "compare": "node scripts/run-compare.mjs",
    "compare:auth": "node scripts/compare-env.mjs --auth",
    "compare:local": "node scripts/compare-env.mjs --b http://localhost:3000",
    "//suites": "── Test suites (production; BASE_URL from .env / config default) ──",
    "test": "playwright test",
    "test:ui": "playwright test --project=Chrome",
    "test:api": "playwright test --project=api",
    "test:monitor": "playwright test --project=monitor",
    "//runners": "── Headline runners (competency & course completion) ──",
    "run:complete-competency": "cross-env BASE_URL=https://sphere.aastrika.org playwright test tests/CompleteCompetency.spec.ts --headed",
    "run:course": "node scripts/run-course.mjs",
    "run:course:env": "cross-env BASE_URL=https://sphere.aastrika.org playwright test tests/CourseComplete.spec.ts --headed",
    "courses:list": "node scripts/run-course.mjs --list",
    "run:course-fresh": "npm run mint:fresh-user && cross-env BASE_URL=https://sphere.aastrika.org USE_FRESH_USER=1 playwright test tests/CourseComplete.spec.ts --headed",
    "mint:fresh-user": "cross-env BASE_URL=https://sphere.aastrika.org playwright test tests/create-account.spec.ts --grep \"Step 5\"",
    "//feature-specs": "── Individual feature specs ──",
    "run:competency": "cross-env BASE_URL=https://sphere.aastrika.org playwright test tests/Competency.spec.ts --headed",
    "run:course-toc": "cross-env BASE_URL=https://sphere.aastrika.org playwright test tests/CourseTOC.spec.ts --headed",
    "run:scorm": "cross-env BASE_URL=https://sphere.aastrika.org playwright test tests/SCROM.spec.ts --headed",
    "run:account": "cross-env BASE_URL=https://sphere.aastrika.org playwright test tests/Account.spec.ts --headed",
    "run:mycourse": "cross-env BASE_URL=https://sphere.aastrika.org playwright test tests/Mycourse.spec.ts --headed",
    "run:private": "cross-env BASE_URL=https://sphere.aastrika.org playwright test tests/PrivatePage.spec.ts --headed",
    "run:search": "cross-env BASE_URL=https://sphere.aastrika.org playwright test tests/Search.spec.ts --headed",
    "run:certificates": "cross-env BASE_URL=https://sphere.aastrika.org playwright test tests/Certificates.spec.ts --project=Chrome --headed",
    "run:unhappy": "cross-env BASE_URL=https://sphere.aastrika.org playwright test tests/Unhappy.spec.ts --project=Chrome --headed",
    "run:logged-out": "cross-env BASE_URL=https://sphere.aastrika.org playwright test tests/LoggedOut.spec.ts --project=Chrome",
    "run:perf": "cross-env BASE_URL=https://sphere.aastrika.org playwright test tests/Performance.spec.ts --project=Chrome --workers=1",
    "test:firefox": "cross-env BASE_URL=https://sphere.aastrika.org playwright test --project=Firefox",
    "test:webkit": "cross-env BASE_URL=https://sphere.aastrika.org playwright test --project=WebKit",
    "test:browsers": "cross-env BASE_URL=https://sphere.aastrika.org playwright test --project=Firefox --project=WebKit",
    "i18n:update": "node scripts/update-translations.mjs",
    "run:public": "cross-env BASE_URL=https://sphere.aastrika.org playwright test tests/PublicPage.spec.ts --headed",
    "run:login": "cross-env BASE_URL=https://sphere.aastrika.org playwright test tests/public-login.spec.ts --headed",
    "run:create-account": "cross-env BASE_URL=https://sphere.aastrika.org playwright test tests/create-account.spec.ts --headed",
    "run:otp": "cross-env BASE_URL=https://sphere.aastrika.org playwright test tests/OTP.spec.ts --headed",
    "forgot": "node scripts/run-forgot.mjs",
    "test:forgot": "playwright test tests/forgot-password.spec.ts --project=Chrome --headed",
    "run:fastlogin": "cross-env BASE_URL=https://sphere.aastrika.org playwright test tests/apiFastLogin.spec.ts --headed",
    "//regression": "── Full regression (run after every release) ──",
    "test:regression": "npm run test:everything",
    "//reports": "── Reports (all pinned to production) ──",
    "report": "playwright show-report",
    "report:full": "cross-env HEADLESS=true BASE_URL=https://sphere.aastrika.org playwright test --project=Chrome",
    "report:all": "cross-env HEADLESS=true BASE_URL=https://sphere.aastrika.org playwright test --project=Chrome --project=api",
    "report:auth": "cross-env HEADLESS=true BASE_URL=https://sphere.aastrika.org STAGING_URL=https://sphere.aastrika.org BLOB=1 BLOB_DIR=blob-reports/auth BLOB_NAME=auth.zip playwright test tests/create-account.spec.ts tests/public-login.spec.ts tests/positiveflow.spec.ts tests/OTP.spec.ts --project=Chrome",
    "report:app": "cross-env HEADLESS=true BASE_URL=https://sphere.aastrika.org BLOB=1 BLOB_DIR=blob-reports/app BLOB_NAME=app.zip playwright test tests/Account.spec.ts tests/Mycourse.spec.ts tests/CourseTOC.spec.ts tests/Competency.spec.ts --project=Chrome",
    "report:course": "cross-env HEADLESS=true BASE_URL=https://sphere.aastrika.org COURSE_NAME=\"Care of Newborn & Newborn Resuscitation\" BLOB=1 BLOB_DIR=blob-reports/course BLOB_NAME=course.zip playwright test tests/CourseComplete.spec.ts --project=Chrome",
    "report:api-blob": "cross-env BASE_URL=https://sphere.aastrika.org BLOB=1 BLOB_DIR=blob-reports/api BLOB_NAME=api.zip playwright test --project=api",
    "report:ci": "cross-env HEADLESS=true BASE_URL=https://sphere.aastrika.org playwright test tests/PublicPage.spec.ts tests/public-login.spec.ts --project=Chrome",
    "report:merge": "node scripts/merge-branded.mjs",
    "reports:pull": "node scripts/pull-ci-reports.mjs",
    "report:sanity": "node -e \"require('fs').rmSync('blob-reports',{recursive:true,force:true})\" && npm run report:auth && npm run report:app && npm run report:course && npm run report:merge",
    "test:everything": "node -e \"require('fs').rmSync('blob-reports',{recursive:true,force:true})\" && npm run report:auth && npm run report:course && npm run report:app && npm run report:api-blob && npm run report:merge",
    "compare:all": "node scripts/compare-env.mjs --auth --open",
    "compare:figma": "node scripts/figma-vs-staging.mjs",
    "compare:journeys": "node scripts/compare-env.mjs --auth --journey all --journey-only --no-catalogue --open",
    "compare:signup": "node scripts/compare-env.mjs --journey create-account --journey-only --no-catalogue --open",
    "test:all": "node scripts/run-all.mjs",
    "test:list": "node scripts/test-inventory.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.9.1",
    "cross-env": "^10.1.0",
    "easy-yopmail": "^5.2.2",
    "exceljs": "^4.4.0"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "nodemailer": "^9.0.3"
  }
}
